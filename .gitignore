# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments and credentials
.env
.env.*
!.env.example
.venv/
venv/
env/
.cdsapirc

# Jupyter and editors
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store

# Root-level notebooks are personal working copies (live outputs, local paths).
# Canonical, output-stripped examples live in notebooks/examples/ and stay tracked.
/*.ipynb

# Runtime outputs, logs, downloads, and caches
outputs/
logs/
tmp/
.cache/

# External datasets are never committed. Keep only documentation and examples.
data/*
!data/README.md
!data/.gitkeep
# ...except the hand-authored admin-boundary provenance manifest (authority/
# vintage/access_date) -- small, not a data asset, and required for
# admin_source.json fail-fast validation (core.assets.load_admin_source_manifest).
!data/cod-ab/
data/cod-ab/*
!data/cod-ab/admin_source.json

# Common geospatial and tabular data products outside data/
*.tif
*.tiff
*.nc
*.grib
*.grib2
*.gpkg
*.gdb
*.gdb.zip
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.parquet
