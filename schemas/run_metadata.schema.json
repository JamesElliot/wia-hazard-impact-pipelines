{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wia-hazard-layers.local/schemas/run_metadata.schema.json",
  "title": "WIA Hazard Pipeline Run Metadata",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_utc",
    "run_config",
    "paths",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "pipeline": {
      "type": "string",
      "minLength": 1,
      "description": "Stable implementation identifier. Emitted by all pipeline runs."
    },
    "method_version": {
      "type": "string",
      "minLength": 1,
      "description": "Version of the affected-population method. Emitted by all pipeline runs."
    },
    "population_rule": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable affected-population rule. Emitted by all pipeline runs."
    },
    "run_config": {
      "type": "object",
      "required": [
        "hazard",
        "iso3",
        "as_of_date",
        "lookback_months",
        "window_start",
        "window_end",
        "target_adm_level",
        "buffer_km"
      ],
      "properties": {
        "hazard": {
          "type": "string",
          "enum": ["cyclone", "drought", "earthquake", "flood", "heat", "hydrodrought", "violence"]
        },
        "iso3": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "lookback_months": {
          "type": "integer",
          "minimum": 1
        },
        "window_start": {
          "type": "string",
          "format": "date"
        },
        "window_end": {
          "type": "string",
          "format": "date"
        },
        "target_adm_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "buffer_km": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "paths": {
      "type": "object",
      "required": ["base", "raw", "intermediate", "rasters", "tables", "qc", "logs", "maps", "cache"],
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "raw": { "type": "string", "minLength": 1 },
        "intermediate": { "type": "string", "minLength": 1 },
        "rasters": { "type": "string", "minLength": 1 },
        "tables": { "type": "string", "minLength": 1 },
        "qc": { "type": "string", "minLength": 1 },
        "logs": { "type": "string", "minLength": 1 },
        "maps": { "type": "string", "minLength": 1 },
        "cache": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "admin_source": {
      "type": "object",
      "description": "Provenance of the administrative boundary dataset used to aggregate this run. Optional for backward compatibility with runs predating this field; validated when present.",
      "required": [
        "authority",
        "vintage",
        "access_date",
        "path",
        "sha256",
        "admin_level",
        "unit_count",
        "pcode_field"
      ],
      "properties": {
        "authority": { "type": "string", "minLength": 1 },
        "vintage": { "type": "string", "pattern": "^[A-Z]+[0-9]{4}-(0[1-9]|1[0-2])$" },
        "access_date": { "type": "string", "format": "date" },
        "path": { "type": "string", "minLength": 1 },
        "asset_id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 1 },
        "admin_level": { "type": "integer", "minimum": 0 },
        "unit_count": { "type": "integer", "minimum": 0 },
        "pcode_field": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
